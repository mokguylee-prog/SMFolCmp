<Window x:Class="SMFolCmp.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SMFolCmp.Views"
        Title="File Compare" Height="900" Width="1400"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#2C3E50" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LeftTitle" Grid.Column="0" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="VS" Foreground="White" FontSize="16" Margin="20,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="RightTitle" Grid.Column="2" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#252535" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Left side buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="FilterAllBtn" Content="All" Click="FilterAll_Click" Padding="10,4" Margin="4,0" Background="#3A7BD5" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    <Button x:Name="FilterDiffBtn" Content="Diff" Click="FilterDiff_Click" Padding="10,4" Margin="4,0" Background="#52A9E8" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    <Button Content="→ Copy to Right" Click="CopySelectionToRight_Click" Padding="10,4" Margin="4,0" Background="#3A7BD5" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    <Button Content="⬇ Insert" Click="InsertLine_Click" Padding="10,4" Margin="4,0" Background="#9B59B6" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    <Button x:Name="SaveLeftBtn" Content="💾 Save Left" Click="SaveLeft_Click" Padding="10,4" Margin="4,0" Background="#FF8C42" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                </StackPanel>
                <!-- Right side buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="← Copy to Left" Click="CopySelectionToLeft_Click" Padding="10,4" Margin="4,0" Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    <Button Content="⬇ Insert" Click="InsertLine_Click" Padding="10,4" Margin="4,0" Background="#9B59B6" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    <Button x:Name="SaveRightBtn" Content="💾 Save Right" Click="SaveRight_Click" Padding="10,4" Margin="4,0" Background="#FF8C42" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    <Button Content="Undo (ESC)" Click="Cancel_Click" Padding="10,4" Margin="8,0,4,0" Background="#FF6B35" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="LeftLineScroll" Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" Background="#252535">
                <ItemsControl x:Name="LeftLineNumbers" Background="Transparent">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding LineNumber}" Width="38" TextAlignment="Right" Padding="0,1,4,1" FontFamily="Consolas" FontSize="13" Foreground="#666" Visibility="{Binding RowVisibility}"/>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="LeftScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="LeftScroll_ScrollChanged" Background="#1E1E2E" PreviewMouseLeftButtonDown="LeftScroll_PreDown" PreviewMouseMove="LeftScroll_PreMove" PreviewMouseLeftButtonUp="LeftScroll_PreUp">
                <ItemsControl x:Name="LeftLines" Background="Transparent">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{Binding Background}" Tag="{Binding}" Visibility="{Binding RowVisibility}">
                            <Border.ContextMenu>
                                <ContextMenu Background="#2D2D30" Foreground="#E0E0E0" Opened="LeftContextMenu_Opened">
                                    <MenuItem Header="→ 오른쪽으로 복사" Click="CopySelectionToRight_Click" Background="#2D2D30" Foreground="#E0E0E0"/>
                                    <Separator Background="#3E3E42"/>
                                    <MenuItem Header="라인 삭제" Click="DeleteSelectedLines_Click" Background="#2D2D30" Foreground="#FF6B6B"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="13" Foreground="{Binding Foreground}" Padding="4,1" local:TextBlockEx.RedHighlights="{Binding RedHighlights}"/>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="RightLineScroll" Grid.Column="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" Background="#252535">
                <ItemsControl x:Name="RightLineNumbers" Background="Transparent">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding LineNumber}" Width="38" TextAlignment="Right" Padding="0,1,4,1" FontFamily="Consolas" FontSize="13" Foreground="#666" Visibility="{Binding RowVisibility}"/>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="RightScroll" Grid.Column="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="RightScroll_ScrollChanged" Background="#1E1E2E" PreviewMouseLeftButtonDown="RightScroll_PreDown" PreviewMouseMove="RightScroll_PreMove" PreviewMouseLeftButtonUp="RightScroll_PreUp">
                <ItemsControl x:Name="RightLines" Background="Transparent">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{Binding Background}" Tag="{Binding}" Visibility="{Binding RowVisibility}">
                            <Border.ContextMenu>
                                <ContextMenu Background="#2D2D30" Foreground="#E0E0E0" Opened="RightContextMenu_Opened">
                                    <MenuItem Header="← 왼쪽으로 복사" Click="CopySelectionToLeft_Click" Background="#2D2D30" Foreground="#E0E0E0"/>
                                    <Separator Background="#3E3E42"/>
                                    <MenuItem Header="라인 삭제" Click="DeleteSelectedLines_Click" Background="#2D2D30" Foreground="#FF6B6B"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="13" Foreground="{Binding Foreground}" Padding="4,1" local:TextBlockEx.RedHighlights="{Binding RedHighlights}"/>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <!-- Edit Area -->
        <Border Grid.Row="3" Background="#252535" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" Padding="10,8" x:Name="EditBorder" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Original:" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                <Border Background="#1E1E2E" BorderBrush="#3E3E42" BorderThickness="1" Padding="8,6" Margin="0,0,0,12">
                    <TextBlock x:Name="OriginalLineText" FontFamily="Consolas" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="Edit:" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EditLineBox" Grid.Column="0" FontFamily="Consolas" FontSize="12" Foreground="White" Background="#1E1E2E" BorderBrush="#3E3E42" BorderThickness="1" Padding="8,6"
                             VerticalAlignment="Center" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="EditLineBox_PreviewKeyDown"/>
                    <Button Grid.Column="1" Content="✓ Save" Click="SaveEditLine_Click" Background="#27AE60" Foreground="White" Padding="12,6" Margin="8,0,4,0" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="✗ Cancel" Click="CancelEditLine_Click" Background="#E74C3C" Foreground="White" Padding="12,6" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Row="4" Background="#252535" Padding="10,5" x:Name="StatusBarBorder">
            <TextBlock x:Name="StatusBar" Foreground="#AAA" FontSize="11"/>
        </Border>
    </Grid>
</Window>
