<Window x:Class="SMFolCmp.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMFolCmp Setup" Height="500" Width="600"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,15">
            <StackPanel>
                <TextBlock Text="SMFolCmp Setup" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Windows 탐색기 통합 설정" Foreground="#AAA" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Padding="30">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="🔧 실행 파일 위치" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="ExePathBox" Padding="10" Background="White" BorderBrush="#CCC" BorderThickness="1" FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="찾기" Click="BrowseButton_Click" Background="#3498DB" Foreground="White" Padding="15,10" Margin="10,0,0,0" FontSize="12" Cursor="Hand" BorderThickness="0"/>
                </Grid>

                <TextBlock Text="🔧 컨텍스트 메뉴 설정" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock TextWrapping="Wrap" Foreground="#333" FontSize="12" Margin="0,0,0,20">
                    Windows 탐색기에서 폴더를 우클릭할 때 2개 메뉴를 추가합니다.
                    <LineBreak/>
                    <LineBreak/>
                    • "SMFolCmp with Left": 폴더를 왼쪽에 저장 (Registry만 수정)
                    <LineBreak/>
                    • "SMFolCmp and Compare": 저장된 왼쪽과 선택한 폴더로 비교 (프로그램 실행)
                    <LineBreak/>
                    <LineBreak/>
                    두 개의 폴더를 동시에 선택했을 때는 자동으로 왼쪽/오른쪽으로 설정됩니다.
                </TextBlock>

                <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Background="#FFFAF0" Margin="0,0,0,20">
                    <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11">
                        ⚠ 참고: 관리자 권한이 필요할 수 있습니다.
                    </TextBlock>
                </Border>

                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,0,0,20" MinHeight="30"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="20,15" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Info -->
                <TextBlock Grid.Column="0" x:Name="InfoText" Foreground="#666" FontSize="12" VerticalAlignment="Center"/>

                <!-- Register Button -->
                <Button Grid.Column="1" Content="등록" Click="RegisterButton_Click"
                        Background="#27AE60" Foreground="White" Padding="20,10" Margin="0,0,10,0"
                        FontSize="13" Cursor="Hand" BorderThickness="0"/>

                <!-- Unregister Button -->
                <Button Grid.Column="2" Content="등록 해제" Click="UnregisterButton_Click"
                        Background="#E74C3C" Foreground="White" Padding="20,10"
                        FontSize="13" Cursor="Hand" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
